# 复制成 .env 后按需修改；密码至少 12 位
DSH_SERVER_ACCOUNT=relayadmin
DSH_SERVER_PASSWORD=CHANGE-ME-12plus
DSH_SERVER_PUBLIC_URL=https://jndnbd.asia
DSH_SERVER_HOST=127.0.0.1
DSH_SERVER_PORT=8080
# 慢消费者阈值：允许为单个连接排队的帧数（1 帧 = 1 MiB），范围 4..256，默认 16。
# 调大能让手机端拉大历史时不至于几秒就被中继断开，代价是内存占用按 连接数 x 该值。
DSH_SERVER_SLOW_CONSUMER_FRAMES=16
LOG_LEVEL=info
